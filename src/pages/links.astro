---
import { Image } from 'astro:assets';
import bannerHero from '../assets/images/banner_links.webp';
import fotoPerfil from '../assets/images/avatar_links.webp';

export const prerender = true;

const GTM_ID = 'GTM-T3ZHXBH7';

const perfil = {
  nome:    'Ana Ester',
  cargo:   'Nutricionista · Poços de Caldas',
};

const redesSociais = [
  {
    nome:      'Instagram',
    href:      'https://www.instagram.com/nutri.anaester',
    ariaLabel: 'Instagram de Ana Ester Nutricionista',
    tracking:  'click-instagram-links',
  },
  {
    nome:      'TikTok',
    href:      'https://www.tiktok.com/@nutri.anaester',
    ariaLabel: 'TikTok de Ana Ester Nutricionista',
    tracking:  'click-tiktok-links',
  },
  {
    nome:      'Facebook',
    href:      'https://www.facebook.com/share/18c1xh9UEU/',
    ariaLabel: 'Facebook de Ana Ester Nutricionista',
    tracking:  'click-facebook-links',
  },
];

const links = [
  {
    id:       'btn-links-site',
    label:    'Acessar o site',
    href:     'https://anaesternutricionista.com.br',
    tracking: 'click-site-links',
    variant:  'primary',
    newTab:   false,
    iconSVG:  '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>',
  },
  {
    id:       'btn-links-wa',
    label:    'Falar no WhatsApp',
    href:     'https://wa.me/5535984566323?text=Ol%C3%A1!%20Gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20como%20funciona%20o%20seu%20acompanhamento%20nutricional.',
    tracking: 'click-whatsapp-links',
    variant:  'ghost',
    newTab:   true,
    iconSVG:  '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>',
  },
  {
    id:       'btn-links-avaliacoes',
    label:    'Deixe sua avaliação',
    href:     'https://maps.app.goo.gl/QrsQDtMMypFogK5MA',
    tracking: 'click-avaliacoes-links',
    variant:  'ghost',
    newTab:   true,
    iconSVG:  '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>',
  },
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />

  <!-- GTM Head -->
  <script is:inline define:vars={{ GTM_ID }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',GTM_ID);
  </script>

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, follow" />
  <meta name="theme-color" content="#436f3e" />
  <title>Ana Ester Nutricionista | Links</title>
  <meta name="description" content="Acompanhamento nutricional individualizado. Fale comigo e comece agora." />
  <link rel="canonical" href="https://anaesternutricionista.com.br/links" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:title" content="Ana Ester Nutricionista | Links" />
  <meta property="og:description" content="Acompanhamento nutricional individualizado. Fale comigo e comece agora." />
  <meta property="og:type" content="website" />

  <!-- Consent Mode v2 -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'analytics_storage': 'denied',
      'wait_for_update': 500
    });
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
      font-weight: 300;
      background-color: #f0ebe3;
      color: #1d1d1c;
      -webkit-font-smoothing: antialiased;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* ── Layout geral ──────────────────────────── */
    .links-page {
      min-height: 100vh;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* ── Hero Banner ───────────────────────────── */
    .hero-banner {
      position: relative;
      width: 100%;
      max-width: 430px;
      height: 220px;
      overflow: hidden;
      flex-shrink: 0;
    }

    .hero-banner__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
      display: block;
    }

    .hero-banner__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(67, 111, 62, 0.15) 0%,
        rgba(29, 29, 28, 0.35) 100%
      );
    }

    /* ── Card Principal ────────────────────────── */
    .profile-card {
      width: 100%;
      max-width: 430px;
      background-color: #f7f4f0;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 20px 48px;
      flex: 1;
    }

    /* ── Avatar ────────────────────────────────── */
    .avatar-wrapper {
      margin-top: -48px;
      z-index: 10;
      position: relative;
    }

    .avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      object-position: center top;
      border: 4px solid #f7f4f0;
      box-shadow: 0 4px 20px rgba(29, 29, 28, 0.18);
      display: block;
      background-color: #e5dfd6;
    }

    /* ── Perfil Info ───────────────────────────── */
    .profile-info {
      margin-top: 14px;
      text-align: center;
      margin-bottom: 8px;
    }

    .profile-name {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 2rem;
      font-weight: 500;
      color: #1d1d1c;
      letter-spacing: 0.01em;
      line-height: 1.1;
    }

    .profile-role {
      font-family: 'DM Sans', system-ui, sans-serif;
      font-size: 11px;
      font-weight: 600;
      color: #535353;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin-top: 5px;
    }

    /* ── Redes Sociais ──────────────────────────── */
    .social-icons {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      margin-top: 20px;
      margin-bottom: 28px;
    }

    .social-icon-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border: 1px solid #d8d0c5;
      border-radius: 6px;
      color: #535353;
      text-decoration: none;
      transition: border-color 0.18s ease, color 0.18s ease, transform 0.15s ease;
    }

    .social-icon-link:hover {
      border-color: #436f3e;
      color: #436f3e;
      transform: translateY(-1px);
    }

    .social-icon-link:active { transform: scale(0.95); }

    .social-icon-link:focus-visible {
      outline: 2px solid #436f3e;
      outline-offset: 2px;
    }

    /* ── Lista de Links ─────────────────────────── */
    .links-list {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* ── Link Button ────────────────────────────── */
    .link-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 16px 24px;
      font-family: 'DM Sans', system-ui, sans-serif;
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.01em;
      text-decoration: none;
      border-radius: 8px;
      border: none;
      transition: background-color 0.18s ease, transform 0.15s ease,
        box-shadow 0.18s ease, border-color 0.18s ease, color 0.18s ease;
      cursor: pointer;
    }

    .link-btn:hover  { transform: translateY(-1px); }
    .link-btn:active { transform: translateY(0); }

    .link-btn:focus-visible {
      outline: 2px solid #436f3e;
      outline-offset: 2px;
    }

    .link-btn.primary {
      background-color: #436f3e;
      color: #ffffff;
      box-shadow: 0 2px 14px rgba(67, 111, 62, 0.28);
    }

    .link-btn.primary:hover {
      background-color: #2f5129;
      box-shadow: 0 4px 20px rgba(67, 111, 62, 0.38);
    }

    .link-btn.ghost {
      background-color: #ffffff;
      color: #1d1d1c;
      border: 1px solid #e5dfd6;
      box-shadow: 0 1px 4px rgba(29, 29, 28, 0.07);
    }

    .link-btn.ghost:hover {
      border-color: #436f3e;
      color: #436f3e;
      box-shadow: 0 4px 14px rgba(29, 29, 28, 0.10);
    }

    /* ── Rodapé ─────────────────────────────────── */
    .page-footer {
      margin-top: 40px;
      font-family: 'DM Sans', system-ui, sans-serif;
      font-size: 11px;
      color: rgba(29, 29, 28, 0.35);
      text-align: center;
      line-height: 1.6;
    }

    /* ── Animações ──────────────────────────────── */
    .link-item {
      opacity: 0;
      transform: translateY(20px);
    }

    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .link-item {
        opacity: 1;
        transform: none;
        animation: none !important;
      }
    }
  </style>
</head>
<body>
  <!-- GTM noscript -->
  <noscript>
    <iframe
      src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
      height="0" width="0"
      style="display:none;visibility:hidden"
    ></iframe>
  </noscript>

  <main class="links-page">

    <!-- ── HERO BANNER ───────────────────────────── -->
    <div class="hero-banner" role="img" aria-label="Banner de Ana Ester Nutricionista">
      <Image
        src={bannerHero}
        alt="Ana Ester Nutricionista"
        class="hero-banner__img"
        width={860}
        height={480}
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-banner__overlay" aria-hidden="true"></div>
    </div>

    <!-- ── CARD PRINCIPAL ────────────────────────── -->
    <div class="profile-card">

      <!-- Avatar na divisória -->
      <div class="avatar-wrapper link-item" style="animation: fadeUp 0.5s 0s ease both">
        <Image
          src={fotoPerfil}
          alt="Foto de Ana Ester Nutricionista"
          class="avatar"
          width={200}
          height={200}
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Nome + Cargo -->
      <div class="profile-info link-item" style="animation: fadeUp 0.5s 0.07s ease both">
        <h1 class="profile-name">{perfil.nome}</h1>
        <p class="profile-role">{perfil.cargo}</p>
      </div>

      <!-- Redes Sociais -->
      <nav class="social-icons link-item" style="animation: fadeUp 0.5s 0.14s ease both" aria-label="Redes sociais">
        {redesSociais.map((rede) => (
          <a
            href={rede.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={rede.ariaLabel}
            data-tracking={rede.tracking}
            data-section="links"
            class="social-icon-link"
          >
            {rede.nome === 'Instagram' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M7.8,2H16.2C19.4,2 22,4.6 22,7.8V16.2C22,19.4 19.4,22 16.2,22H7.8C4.6,22 2,19.4 2,16.2V7.8C2,4.6 4.6,2 7.8,2M7.6,4A3.6,3.6 0 0,0 4,7.6V16.4A3.6,3.6 0 0,0 7.6,20H16.4A3.6,3.6 0 0,0 20,16.4V7.6A3.6,3.6 0 0,0 16.4,4H7.6M17.2,6A1.2,1.2 0 0,1 18.4,7.2A1.2,1.2 0 0,1 17.2,8.4A1.2,1.2 0 0,1 16,7.2A1.2,1.2 0 0,1 17.2,6M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/>
              </svg>
            )}
            {rede.nome === 'TikTok' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.19 8.19 0 004.79 1.53V6.78a4.85 4.85 0 01-1.02-.09z"/>
              </svg>
            )}
            {rede.nome === 'Facebook' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            )}
          </a>
        ))}
      </nav>

      <!-- Links -->
      <div class="links-list" role="list">
        {links.map((link, i) => (
          <div role="listitem" class="link-item" style={`animation: fadeUp 0.5s ${0.20 + i * 0.08}s ease both`}>
            <a
              href={link.href}
              id={link.id}
              data-tracking={link.tracking}
              data-section="links"
              class={`link-btn ${link.variant}`}
              {...link.newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
            >
              <span class="link-btn-icon" aria-hidden="true" set:html={link.iconSVG}></span>
              <span>{link.label}</span>
            </a>
          </div>
        ))}
      </div>

      <!-- Rodapé -->
      <footer class="page-footer link-item" style={`animation: fadeUp 0.5s ${0.20 + links.length * 0.08}s ease both`}>
        <p>© {currentYear} Ana Ester Messias Lima Martins</p>
      </footer>

    </div>
  </main>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'view_links', page_type: 'links_page' });

    document.addEventListener('click', function(e) {
      var el = e.target.closest('[data-tracking]');
      if (!el) return;
      var action = el.getAttribute('data-tracking');
      var section = el.getAttribute('data-section');
      window.dataLayer.push({ event: 'link_click', click_action: action, click_section: section });
      if (action && action.includes('whatsapp')) {
        window.dataLayer.push({ event: 'contato_wpp', click_action: action, click_section: section });
      }
    });
  </script>
</body>
</html>
