---
const WA_LINK =
  "https://wa.me/5535984566323?text=Ol%C3%A1!%20Vi%20seu%20perfil%20no%20Google%20e%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20como%20funciona%20o%20seu%20acompanhamento%20nutricional.";
---

<!-- Botão CTA fixo no bottom — só mobile, some quando CTA do hero aparecer -->
<div
  id="hero-mobile-cta"
  class="fixed bottom-0 left-0 right-0 z-40 lg:hidden px-4 pb-4 pt-3"
  style="background: linear-gradient(to top, rgba(255,255,255,0.98) 70%, rgba(255,255,255,0));"
  aria-hidden="true"
>
  <a
    href={WA_LINK}
    id="btn-hero-mobile-cta-fixed"
    data-tracking="click-whatsapp-hero-fixed"
    data-section="hero-fixed"
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center gap-2.5 w-full font-sans font-medium text-base py-4 px-7 rounded-sm btn-secondary-gold"
    tabindex="-1"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.075.528 4.025 1.456 5.732L0 24l6.458-1.427C8.137 23.497 10.025 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.86 0-3.629-.476-5.182-1.314l-.371-.218-3.831.847.86-3.726-.24-.386A9.927 9.927 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
    </svg>
    Fale agora pelo WhatsApp
  </a>
</div>

<script>
  (function () {
    const fixedCTA = document.getElementById("hero-mobile-cta");
    if (!fixedCTA) return;

    // Observa o botão CTA dentro do hero
    const heroCTA = document.querySelector('[data-tracking="click-whatsapp-hero"]');
    if (!heroCTA) return;

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (entry.isIntersecting) {
          // CTA do hero visível → esconde o fixo
          fixedCTA.style.opacity = "0";
          fixedCTA.style.pointerEvents = "none";
          fixedCTA.setAttribute("aria-hidden", "true");
          const link = fixedCTA.querySelector("a");
          if (link) link.setAttribute("tabindex", "-1");
        } else {
          // CTA do hero fora de vista → mostra o fixo
          fixedCTA.style.opacity = "1";
          fixedCTA.style.pointerEvents = "auto";
          fixedCTA.setAttribute("aria-hidden", "false");
          const link = fixedCTA.querySelector("a");
          if (link) link.setAttribute("tabindex", "0");
        }
      },
      { threshold: 0.5 }
    );

    observer.observe(heroCTA);
  })();
</script>

<style>
  #hero-mobile-cta {
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .btn-secondary-gold {
    background-image: linear-gradient(135deg, #d59740 0%, #f9f395 50%, #c4872f 100%);
    box-shadow: 0 4px 15px rgba(213, 151, 64, 0.25);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease-out;
    color: #1d1d1c;
    text-decoration: none;
  }

  .btn-secondary-gold:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 25px rgba(213, 151, 64, 0.35);
  }
</style>
