---
import Button from '../global/Button.astro';

const WA_LINK = 'https://wa.me/5535984566323?text=Ol%C3%A1!%20Vi%20seu%20site%20no%20Google%20e%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20como%20funciona%20o%20seu%20acompanhamento%20nutricional.';
---

<section
  id="cta-final"
  class="relative bg-gradient-to-b from-primary to-primary-dark section-py overflow-hidden"
  aria-labelledby="cta-heading"
>
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 w-72 h-72 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2" aria-hidden="true"></div>

  <div class="container-content text-center relative z-10">
    <p class="label-tag text-secondary mb-6" data-animate>Próximo passo</p>

    <h2
      id="cta-heading"
      class="font-serif text-display-xl text-white max-w-2xl mx-auto mb-6"
      data-animate
    >
      Pronto para transformar sua saúde?
    </h2>

    <p class="font-sans text-lg text-white/80 max-w-lg mx-auto mb-12" data-animate>
      Entre em contato comigo agora. Vou te explicar como funciona o acompanhamento e como podemos começar essa jornada juntos de forma leve e real.
    </p>

    <div data-animate>
      <Button
        label="Fale agora pelo WhatsApp"
        href={WA_LINK}
        variant="secondary-gold"
        trackingId="btn-cta-final-wa"
        trackingAction="click-whatsapp-cta-final"
        trackingSection="cta-final"
        external
      />
    </div>
  </div>
</section>
