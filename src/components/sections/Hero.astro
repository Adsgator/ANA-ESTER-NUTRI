---
import { Image } from "astro:assets";
import Button from "../global/Button.astro";
import heroImg from "../../assets/images/img_hero_ana.webp";
import heroMobileImg from "../../assets/images/img_hero_ana_mobile.webp";

const WA_LINK =
  "https://wa.me/5535984566323?text=Ol%C3%A1!%20Vi%20seu%20site%20no%20Google%20e%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20como%20funciona%20o%20seu%20acompanhamento%20nutricional.";
---

<section
  id="hero-section"
  class="relative bg-background pt-0 lg:pt-[12rem] pb-[60px] overflow-hidden"
  style="box-shadow: inset 0 -12px 40px -6px rgba(0,0,0,0.15);"
  aria-labelledby="hero-heading"
>
  <!-- Imagem mobile — aparece só em mobile/tablet, full-width no topo -->
  <div class="block lg:hidden w-full" aria-hidden="false">
    <Image
      src={heroMobileImg}
      alt="Ana Ester, nutricionista em Poços de Caldas"
      width={800}
      height={600}
      loading="eager"
      fetchpriority="high"
      format="webp"
      class="w-full h-auto object-cover"
    />
  </div>

  <!-- Background com cor sólida #edefef -->
  <div
    class="hidden lg:block absolute right-0 top-0 bottom-0 w-1/2 overflow-hidden pointer-events-none"
    aria-hidden="true"
    style="clip-path: polygon(30% 0, 100% 0, 100% 100%, 0% 100%); background-color: #edefef;"
  >
  </div>

  <!-- Textura de fundo sutil -->
  <div
    class="hidden lg:block absolute inset-0 opacity-[0.025] pointer-events-none bg-[radial-gradient(ellipse_at_top_right,_#436f3e_0%,_transparent_60%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-wide pt-8 lg:pt-0">
    <div
      class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-12 lg:gap-16 items-start relative z-10"
    >
      <!-- Texto -->
      <div>
        <!-- Eyebrow label -->
        <p class="label-tag mb-5 animate-fade-up" style="animation-delay: 0ms">
          Nutricionista em Poços de Caldas
        </p>

        <!-- H1 — Dor #1 -->
        <h1
          id="hero-heading"
          class="font-serif text-display-xl text-text-main mb-6 animate-fade-up"
          style="animation-delay: 80ms; width: 95%; font-weight: 700;"
        >
          Você não precisa de um plano alimentar restrito para ter resultados
          reais
        </h1>

        <!-- Subtítulo -->
        <p
          class="font-sans text-lg text-text-soft leading-relaxed mb-8 max-w-lg animate-fade-up"
          style="animation-delay: 160ms"
        >
          Acompanhamento nutricional individualizado, adaptado à sua rotina e ao
          seu jeito de viver. Você merece um processo leve para ser vivido e
          eficiente para transformar.
        </p>

        <!-- CTA -->
        <div class="animate-fade-up" style="animation-delay: 240ms">
          <Button
            label="Fale agora pelo WhatsApp"
            href={WA_LINK}
            variant="secondary-gold"
            trackingId="btn-hero-wa"
            trackingAction="click-whatsapp-hero"
            trackingSection="hero"
            external
          />
        </div>
      </div>

      <!-- Imagem -->
      <div
        class="relative animate-fade-up hidden lg:flex justify-start"
        style="animation-delay: 200ms; margin-bottom: -60px; margin-top: -40px; margin-left: -80px;"
      >
        <!-- Main image -->
        <div
          class="w-full max-w-sm overflow-visible relative"
          aria-label="[Foto de Ana Ester — sem fundo]"
        >
          <Image
            src={heroImg}
            alt="Ana Ester, nutricionista em Poços de Caldas"
            width={500}
            height={667}
            loading="eager"
            fetchpriority="high"
            format="webp"
            class="w-full h-auto"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-up {
    animation: fadeUp 0.7s ease both;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-up {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
